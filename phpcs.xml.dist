<?xml version="1.0"?>
<ruleset name="SwatchCraft">
	<description>WordPress Coding Standards for SwatchCraft.</description>

	<file>install.php</file>
	<file>uninstall.php</file>
	<file>src</file>


	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wp-smart-variations"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
				<element value="manage_product_terms"/>
				<element value="edit_products"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="SwatchCraft"/>
				<element value="swatchcraft"/>
				<element value="SWATCHCRAFT"/>
			</property>
		</properties>
	</rule>
</ruleset>
